# ============================================================================
# Calendários acadêmicos — configuração por ambiente
# Copie para .env na raiz do projeto. Tudo é opcional: sem uma credencial, a
# função aparece na interface como "aguardando configuração" — nada é simulado
# em silêncio.
# ============================================================================

# -- Servidor ----------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
# Pasta dos dados (banco SQLite + PDFs originais), relativa à raiz do projeto
DATA_DIR=data
LOG_LEVEL=info

# Interface publicada em outro domínio (ex.: Vercel): origens liberadas, separadas por vírgula
CORS_ORIGINS=

# -- Autenticação ------------------------------------------------------------
# dev   = "Entrar com a conta Microsoft" entra direto, com papel admin (SEM Outlook)
# entra = Microsoft Entra ID (OIDC) — a TI implementa; ver docs/INTEGRACAO_TI.md
AUTH_MODE=dev
DEV_USER_NAME=Equipe Acadêmica
DEV_USER_EMAIL=equipe.academica@anchieta.br
SESSION_HOURS=12

# -- Modo demonstração -------------------------------------------------------
# true = sem gateway configurado, os envios são registrados como
# "Simulado (demonstração)" e NADA sai para aluno algum.
DEMO_MODE=false

# -- Uploads -----------------------------------------------------------------
MAX_FILE_MB=25
MAX_BATCH_MB=300
MAX_ZIP_ENTRIES=500
MAX_UNZIPPED_MB=600
IMPORT_CONCURRENCY=2

# -- IA / OCR (páginas digitalizadas, sem texto selecionável) ----------------
# PDFs com texto selecionável NÃO usam IA: são lidos pela camada de texto.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# -- Push (gateway HTTP da TI — contrato em docs/API.md) ----------------------
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=

# -- E-mail (gateway HTTP da TI — mesmo contrato) -----------------------------
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# -- Integrações -------------------------------------------------------------
# Chave que os sistemas institucionais enviam em X-Integration-Key para
# POST /api/integrations/student-events e /student-preferences
INTEGRATION_API_KEY=
# Chave opcional para a leitura pública (portal/app) de /api/public/calendars
PUBLIC_API_KEY=

# -- Processos de fundo ------------------------------------------------------
# false = rode `npm run worker -w @calendarios/api` em outro processo
RUN_WORKERS=true
SCHEDULER_INTERVAL_SECONDS=20
SCHEDULER_MAX_ATTEMPTS=3
